{
	"name": "home-work-hours-tracker",
	"private": true,
	"version": "0.1.0",
	"description": "Self-hosted diary of hours worked from home, with automatic prefill and an accountant-ready spreadsheet export.",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && (simple-git-hooks || echo 'git hooks not installed')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:unit": "vitest",
		"test:coverage": "vitest --run --coverage",
		"test:e2e": "playwright test",
		"verify": "npm run lint && npm run check && npm run test:coverage && npm run test:e2e",
		"pii:check": "node scripts/check-pii.mjs --all",
		"db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
		"db:studio": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs studio",
		"assets:generate": "node scripts/generate-icons.mjs",
		"db:seed": "tsx scripts/seed-dev-db.ts"
	},
	"simple-git-hooks": {
		"pre-commit": "node scripts/check-pii.mjs --staged",
		"commit-msg": "node scripts/check-pii.mjs --commit-msg \"$1\""
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/bricolage-grotesque": "^5.3.0",
		"@fontsource-variable/public-sans": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.45.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"@vite-pwa/sveltekit": "^1.1.0",
		"@vitest/browser-playwright": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.11",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.1",
		"sharp": "^0.35.4",
		"simple-git-hooks": "^2.14.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.13",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"workbox-core": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-recipes": "^7.4.1"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.2",
		"date-holidays": "^3.24.4",
		"exceljs": "^4.4.0",
		"zod": "^4.1.13"
	},
	"license": "MIT"
}
