# Copy to .env and adjust as needed. .env itself is gitignored.

# Path to the SQLite database file used by the app.
DATABASE_URL=./data/home-work-hours.db

# Timezone used to decide what "today" is (Unraid passes this to containers automatically).
TZ=Australia/Melbourne

# Optional, tests only: pin "today" (YYYY-MM-DD) for deterministic E2E runs. Never set in production.
# APP_FIXED_DATE=2026-09-14
